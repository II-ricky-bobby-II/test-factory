  },
  "semantic": {
    "surfacePage": "{color.paper}",
    "surfaceCard": "{color.warmWhite}",
    "surfaceInverse": "{color.ink}",
    "surfaceMuted": "{color.taupe}",
    "textPrimary": "{color.ink}",
    "textSecondary": "rgba(5,5,5,0.72)",
