    "textInverse": "{color.warmWhite}",
    "borderDefault": "rgba(5,5,5,0.16)",
    "borderGrid": "rgba(216,211,200,0.72)",
    "focusRing": "{color.clay}"
  },
  "font": {
    "display": "'PP Migra', 'Cormorant Garamond', 'Bodoni 72', 'Didot', Georgia, serif",
    "displayItalic": "'PP Migra Italic', 'Cormorant Garamond', 'Bodoni 72', 'Didot', Georgia, serif",
    "sans": "'Gilroy', 'Inter', 'Helvetica Neue', Arial, sans-serif",
    "script": "'Microsoft Himalaya', serif"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px",
    "9": "80px",
    "10": "96px",
    "11": "128px",
    "12": "160px",
    "13": "192px",
    "14": "240px"
  },
  "layout": {
    "desktopColumns": 12,
    "tabletColumns": 8,
    "mobileColumns": 4,
    "desktopMargin": "64px",
    "tabletMargin": "32px",
    "mobileMargin": "20px",
    "desktopGutter": "24px",
    "tabletGutter": "20px",
    "mobileGutter": "16px",
    "maxContentWidth": "1280px",
