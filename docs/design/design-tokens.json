  "radius": {
    "none": "0",
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "full": "999px"
  },
  "shadow": {
    "none": "none",
    "soft": "0 18px 40px rgba(5,5,5,0.10)",
    "modal": "0 28px 80px rgba(5,5,5,0.28)"
