{
  "color": {
    "ink": "#050505",
    "charcoal": "#171411",
    "espresso": "#21170F",
    "paper": "#F7F3EA",
    "warmWhite": "#FFFCF5",
    "mist": "#ECEBE7",
    "gridLine": "#D8D3C8",
    "taupe": "#918A7C",
    "clay": "#D65A2B",
    "saffron": "#E5B72E",
    "coffee": "#9B6436",
    "cream": "#E7D0AE",
    "leaf": "#405733",
    "deepBlue": "#223D66",
    "error": "#9E2F1C",
